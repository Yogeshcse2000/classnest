# Copy this file to .env and fill in your own values.
# .env is private and never committed. This file is safe to commit.

# Port the server listens on (open http://localhost:PORT)
PORT=3000

# Where the SQLite database file is saved
DB_PATH=data/classnest.db

# First admin account, created by: npm run seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
