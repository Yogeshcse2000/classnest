# Copy this file to .env and fill in your own values.
# .env is private and never committed. This file is safe to commit.

# Port the server listens on (open http://localhost:PORT)
PORT=3000

# Where the SQLite database file is saved
DB_PATH=data/classnest.db

# Where uploaded .zip files are saved
UPLOADS_PATH=uploads

# Secret used to sign login cookies. Make a random one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# First admin account, created by: npm run seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
