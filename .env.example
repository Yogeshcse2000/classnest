# Copy this file to .env (on Windows: copy .env.example .env).
# .env is private and never committed. This file is safe to commit and
# holds demo values only. Change them before putting the app online.

# Port the server listens on (open http://localhost:PORT)
PORT=3000

# Where the SQLite database file is saved
DB_PATH=data/classnest.db

# Where uploaded .zip files are saved
UPLOADS_PATH=uploads

# Secret used to sign login cookies. This is a demo value: make your own with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=demo-secret-change-me-before-going-online

# First admin account, created by: npm run seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@classnest.local
ADMIN_PASSWORD=ClassNest@Demo1
